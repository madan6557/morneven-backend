# Morneven Backend Environment Example
# Copy this file to .env and replace every placeholder before deploy.
# Do not commit real secrets, Railway resource names, bucket credentials, or production URLs.
# Runtime validation source of truth: src/config/env.ts

# --- Application ---
# HOST: non-empty bind host. Use :: for IPv4/IPv6, or 0.0.0.0 if your platform requires it.
HOST=::

# PORT: positive integer. Railway usually injects PORT automatically.
PORT=8080

# NODE_ENV: development | test | production.
NODE_ENV=development

# CORS_ORIGIN: comma-separated browser origins allowed to call the API.
# Example production value: https://morneven.com,https://www.morneven.com
CORS_ORIGIN=http://localhost:3000

# MAX_UPLOAD_MB: positive integer for normal file uploads.
# Migration backup ZIP restore has a separate large-upload route limit in code.
MAX_UPLOAD_MB=20

# AUTH_COOKIE_ENABLED: true | false.
# Use true only when cookie auth is intentionally deployed.
AUTH_COOKIE_ENABLED=false

# AUTH_COOKIE_DOMAIN: optional cookie domain, for example .morneven.com.
# AUTH_COOKIE_DOMAIN=.example.com

# --- Database ---
# DATABASE_URL: PostgreSQL connection string required by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Authentication / JWT ---
# JWT_ACCESS_SECRET: required, minimum 16 characters.
JWT_ACCESS_SECRET=replace-with-min-16-chars

# JWT_REFRESH_SECRET: required, minimum 16 characters.
JWT_REFRESH_SECRET=replace-with-min-16-chars

# SECURITY_HASH_PEPPER: optional, minimum 16 characters.
# If omitted, backend falls back to JWT_ACCESS_SECRET.
# SECURITY_HASH_PEPPER=replace-with-min-16-chars

# --- Rate Limiting ---
# RATE_LIMIT_WINDOW_MS: positive integer in milliseconds.
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX: positive integer request cap per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=1200

# MIGRATION_RATE_LIMIT_WINDOW_MS: positive integer in milliseconds for internal migration transfer endpoints.
MIGRATION_RATE_LIMIT_WINDOW_MS=900000

# MIGRATION_RATE_LIMIT_MAX: positive integer request cap for /settings/migration/* transfer endpoints.
# Recommended to be higher than RATE_LIMIT_MAX because one migration may transfer many assets.
MIGRATION_RATE_LIMIT_MAX=5000

# AUTH_RATE_LIMIT_WINDOW_MS: positive integer in milliseconds for auth endpoints.
AUTH_RATE_LIMIT_WINDOW_MS=900000

# AUTH_RATE_LIMIT_MAX: positive integer request cap per AUTH_RATE_LIMIT_WINDOW_MS.
AUTH_RATE_LIMIT_MAX=100

# --- Maintenance Keys ---
# MIGRATION_KEY: optional, minimum 16 characters. Required to enable migration actions.
MIGRATION_KEY=replace-with-min-16-chars

# EXTRACTION_KEY: optional, minimum 16 characters. Required to enable extraction or backup actions.
EXTRACTION_KEY=replace-with-min-16-chars

# --- Security Controls ---
# SECURITY_LEVEL: integer 0-5. 0 is least strict, 5 is strictest and the default.
SECURITY_LEVEL=5

# SECURITY_BLOCK_TTL_MS: positive integer block duration in milliseconds.
SECURITY_BLOCK_TTL_MS=900000

# SECURITY_RETENTION_DAYS: positive integer event retention duration in days.
SECURITY_RETENTION_DAYS=90

# FILE_SCAN_PROVIDER: none | mock.
FILE_SCAN_PROVIDER=none

# --- Storage ---
# STORAGE_DRIVER: local | gcs | s3.
STORAGE_DRIVER=local

# Local storage, used when STORAGE_DRIVER=local.
LOCAL_STORAGE_PATH=storage
LOCAL_STORAGE_BASE_PATH=/storage

# Google Cloud Storage, used when STORAGE_DRIVER=gcs.
# GCS_BUCKET_NAME=replace-with-gcs-bucket-name
# GCS_PROJECT_ID=replace-with-gcs-project-id

# S3 or Railway bucket, used when STORAGE_DRIVER=s3.
# S3_BUCKET_NAME=replace-with-s3-bucket-name
# S3_REGION=replace-with-s3-region
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=replace-with-access-key-id
# S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# S3_FORCE_PATH_STYLE=false

# --- Bot Manager ---
# BOT_MANAGER_KEY: optional, minimum 16 characters. Required for credential-gated Bot Manager actions.
# BOT_MANAGER_KEY=replace-with-min-16-chars

# BOT_MANAGER_ENCRYPTION_KEY: optional, minimum 32 characters. Required when encrypted bot credentials are used.
# BOT_MANAGER_ENCRYPTION_KEY=replace-with-min-32-chars

# BOT_MANAGER_SYNC_TOKEN: optional, minimum 16 characters for internal sync calls.
# BOT_MANAGER_SYNC_TOKEN=replace-with-min-16-chars

# --- ZeroClaw Runtime ---
# ZEROCLAW_INTERNAL_BASE_URL: optional URL. Bare hosts are auto-prefixed with http:// by the backend.
# ZEROCLAW_INTERNAL_BASE_URL=http://zeroclaw-service:8080

# ZEROCLAW_MORNEVEN_RELOAD_TOKEN: optional, minimum 16 characters.
# ZEROCLAW_MORNEVEN_RELOAD_TOKEN=replace-with-min-16-chars
