# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/morneven

# Auth
JWT_ACCESS_SECRET=replace-with-min-16-chars
JWT_REFRESH_SECRET=replace-with-min-16-chars
MIGRATION_KEY=replace-with-min-16-chars
EXTRACTION_KEY=replace-with-min-16-chars

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Upload
MAX_UPLOAD_MB=20

# Storage driver: local | gcs | s3
STORAGE_DRIVER=local

# Local storage (for STORAGE_DRIVER=local)
LOCAL_STORAGE_PATH=storage
LOCAL_STORAGE_BASE_PATH=/storage

# GCS storage (for STORAGE_DRIVER=gcs)
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_PUBLIC_BASE_URL=

# S3 / Railway Bucket storage (for STORAGE_DRIVER=s3)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Security Global Controls
SECURITY_LEVEL=5
SECURITY_BLOCK_TTL_MS=900000
SECURITY_RETENTION_DAYS=90
FILE_SCAN_PROVIDER=none
AUTH_COOKIE_ENABLED=false
