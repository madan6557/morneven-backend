generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  author
  admin
  security
  personel
  guest
}

enum AccountStatus {
  active
  suspended
  banned
  deleted
}

enum Track {
  executive
  field
  mechanic
  logistics
}

enum ProjectStatus {
  Planning
  OnProgress
  OnHold
  Completed
  Canceled
}

enum MediaType {
  image
  video
  link
  file
}

enum EntityType {
  gallery
  character
  place
  technology
  creature
  event
  other
  project
}

enum ContentReactionKind {
  like
  dislike
  star
}

enum MapStatus {
  safe
  caution
  danger
  restricted
  mission
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  role          Role     @default(personel)
  accountStatus AccountStatus @default(active)
  level         Int      @default(1)
  track         Track    @default(executive)
  note          String?
  statusReason  String?
  statusChangedAt DateTime?
  statusExpiresAt DateTime?
  disciplineStrikeCount Int @default(0)
  disciplineTier Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  securitySessions SecuritySession[]
  news          News[]
  galleryItems  GalleryItem[]
  comments      Comment[]
  replies       Reply[]
  contentReactions ContentReaction[]
  submittedReports PersonnelReport[] @relation("PersonnelReportReporter")
  receivedReports  PersonnelReport[] @relation("PersonnelReportTarget")
  resolvedReports  PersonnelReport[] @relation("PersonnelReportResolver")
  passwordResetRequests PasswordResetRequest[] @relation("PasswordResetRequestTarget")
  reviewedPasswordResetRequests PasswordResetRequest[] @relation("PasswordResetRequestReviewer")
}

model CommandCenterSettings {
  id                String  @id @default(uuid())
  presetKey         String  @unique
  presetName        String  @default("System Preset")
  isActive          Boolean @default(false)
  showStats         Boolean @default(true)
  showProjects      Boolean @default(true)
  showNews          Boolean @default(true)
  showCharacters    Boolean @default(true)
  showPlaces        Boolean @default(true)
  showTechnology    Boolean @default(true)
  showGallery       Boolean @default(true)
  showQuickActions  Boolean @default(true)
  welcomeMessage    String  @default("Here's your operational overview.")
  itemLimits        Json    @default("{\"projects\":5,\"news\":6,\"characters\":3,\"places\":3,\"technology\":3,\"gallery\":4}")
  manualSelections  Json    @default("{\"projects\":[],\"news\":[],\"characters\":[],\"places\":[],\"technology\":[],\"gallery\":[]}")
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  sessionId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   SecuritySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model SecuritySession {
  id            String   @id @default(uuid())
  userId        String
  ipHash        String?
  userAgentHash String?
  riskScore     Int      @default(0)
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

model Project {
  id         String        @id @default(uuid())
  title      String
  status     ProjectStatus
  thumbnail  String        @default("")
  shortDesc  String
  fullDesc   String
  docs       Json          @default("[]")
  archived   Boolean       @default(false)
  contributor String?
  meta       Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  patches    ProjectPatch[]
}

model ProjectPatch {
  id        String   @id @default(uuid())
  projectId String
  version   String
  patchDate DateTime
  notes     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model News {
  id          String   @id @default(uuid())
  authorId    String
  text        String
  publishDate DateTime
  hasDetail   Boolean  @default(false)
  thumbnail   String?
  body        String?
  author      User     @relation(fields: [authorId], references: [id])
  attachments NewsAttachment[]
}

model NewsAttachment {
  id      String   @id @default(uuid())
  newsId  String
  type    MediaType
  url     String
  caption String?
  news    News @relation(fields: [newsId], references: [id], onDelete: Cascade)
}

model LoreItem {
  id          String    @id @default(uuid())
  category    EntityType
  name        String
  type        String?
  thumbnail   String?
  shortDesc   String
  fullDesc    String
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EntityDoc {
  id         String    @id @default(uuid())
  entityType EntityType
  entityId   String
  type       MediaType
  url        String
  caption    String?
  date       String?
}

model GalleryItem {
  id         String    @id @default(uuid())
  type       MediaType
  title      String
  thumbnail  String    @default("")
  mediaUrl   String?
  caption    String
  videoUrl   String?
  uploadDate DateTime  @default(now())
  uploadedBy String
  tags       GalleryTag[]
  uploader   User      @relation(fields: [uploadedBy], references: [id])
}

model GalleryTag {
  id            String      @id @default(uuid())
  galleryItemId String
  tag           String
  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
}

model ContentMetric {
  id         String     @id @default(uuid())
  entityType EntityType
  entityId   String
  views      Int        @default(0)
  likes      Int        @default(0)
  dislikes   Int        @default(0)
  stars      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, views])
  @@index([entityType, likes])
  @@index([entityType, dislikes])
  @@index([entityType, stars])
}

model ContentViewEvent {
  id          String     @id @default(uuid())
  entityType  EntityType
  entityId    String
  viewerKey   String
  viewerKind  String
  bucketStart DateTime
  createdAt   DateTime   @default(now())

  @@unique([entityType, entityId, viewerKey, bucketStart])
  @@index([entityType, entityId, createdAt])
  @@index([viewerKey, createdAt])
}

model ContentReaction {
  id         String              @id @default(uuid())
  entityType EntityType
  entityId   String
  userId     String
  kind       ContentReactionKind
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, userId, kind])
  @@index([entityType, entityId])
  @@index([userId])
}

model MapMarker {
  id          String    @id @default(uuid())
  name        String
  status      MapStatus
  x           Float
  y           Float
  description String
  loreLink    String?
}

model MapImage {
  id        String   @id @default("main")
  imageUrl  String
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String     @id @default(uuid())
  entityType EntityType
  entityId   String
  authorId   String
  text       String
  createdAt  DateTime   @default(now())
  mentions   Mention[]
  replies    Reply[]
  author     User       @relation(fields: [authorId], references: [id])
}

model Reply {
  id         String    @id @default(uuid())
  commentId  String
  authorId   String
  text       String
  createdAt  DateTime  @default(now())
  mentions   Mention[]
  comment    Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id])
}

model Mention {
  id              String   @id @default(uuid())
  commentId       String?
  replyId         String?
  mentionedUserId String
  startIdx        Int
  endIdx          Int
  comment         Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reply           Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
}

model ManagementRequest {
  id              String   @id @default(uuid())
  kind            String
  requester       String
  requesterTrack  Track
  requesterLevel  Int
  payload         Json     @default("{}")
  reason          String
  status          String   @default("pending")
  reviewer        String?
  reviewNote      String?
  createdAt       DateTime @default(now())
  decidedAt       DateTime?
}

model Team {
  id         String   @id @default(uuid())
  name       String
  leader     String
  members    Json     @default("[]")
  track      Track
  createdAt  DateTime @default(now())
  cycleYear  Int
  completed  Int      @default(0)
}

model QuotaRecord {
  id         String @id @default(uuid())
  username   String @unique
  monthly    Json   @default("{}")
  yearly     Json   @default("{}")
  supervised Json   @default("{}")
}

model Notification {
  id        String   @id @default(uuid())
  kind      String
  title     String
  body      String?
  recipient String
  sender    String?
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  link      String?
  readStates NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  username       String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, username])
}

model ChatConversation {
  id            String                   @id @default(uuid())
  kind          String
  name          String
  source        Json?
  systemManaged Boolean                  @default(false)
  createdBy     String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  members       ChatConversationMember[]
  messages      ChatMessage[]
  readStates    ChatReadState[]
}

model ChatConversationMember {
  id             String           @id @default(uuid())
  conversationId String
  username       String
  role           String           @default("member")
  status         String           @default("active")
  invitedBy      String?
  joinedAt       DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, username])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  author         String
  text           String           @default("")
  attachments    Json             @default("[]")
  system         Boolean          @default(false)
  replyTo        Json?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ChatReadState {
  id             String           @id @default(uuid())
  conversationId String
  username       String
  lastReadAt     DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, username])
}

model ExtractionJob {
  id           String   @id @default(uuid())
  mode         String
  autoDownload Boolean  @default(false)
  status       String   @default("processing")
  createdBy    String
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  expiresAt    DateTime
  downloadName String?
  artifactPath String?
  artifactUrl  String?
  error        String?
  progress     Json     @default("{\"percent\":0,\"stage\":\"queued\",\"message\":\"Queued\"}")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model SecurityEvent {
  id            String   @id @default(uuid())
  requestId     String?
  actorId       String?
  actorUsername String?
  sessionId     String?
  ipHash        String?
  userAgentHash String?
  action        String
  resource      String?
  resourceId    String?
  severity      String
  riskScore     Int      @default(0)
  decision      String
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([action, createdAt])
  @@index([actorUsername, createdAt])
}

model SecurityBlock {
  id           String   @id @default(uuid())
  subjectType  String
  subjectHash  String
  reason       String
  severity     String
  expiresAt    DateTime
  createdBy    String?
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  revokeReason String?

  @@index([subjectType, subjectHash, expiresAt])
  @@index([revokedAt, expiresAt])
}

model SecurityPolicy {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FileScanRecord {
  id         String   @id @default(uuid())
  objectPath String
  sha256     String
  mime       String
  size       Int
  verdict    String
  provider   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([sha256])
  @@index([verdict, createdAt])
}

model PersonnelReport {
  id               String   @id @default(uuid())
  reporterId       String
  targetUserId     String
  category         String
  details          String
  status           String   @default("open")
  resolutionAction String?
  resolutionNote   String?
  resolvedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  resolvedAt       DateTime?
  reporter         User     @relation("PersonnelReportReporter", fields: [reporterId], references: [id])
  target           User     @relation("PersonnelReportTarget", fields: [targetUserId], references: [id])
  resolvedBy       User?    @relation("PersonnelReportResolver", fields: [resolvedById], references: [id])

  @@index([targetUserId, status])
  @@index([reporterId, createdAt])
}

model PasswordResetRequest {
  id              String   @id @default(uuid())
  targetUserId    String
  email           String
  username        String
  identityProof   String
  newPasswordHash String
  status          String   @default("pending")
  reviewNote      String?
  reviewedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reviewedAt      DateTime?
  completedAt     DateTime?
  targetUser      User     @relation("PasswordResetRequestTarget", fields: [targetUserId], references: [id])
  reviewedBy      User?    @relation("PasswordResetRequestReviewer", fields: [reviewedById], references: [id])

  @@index([targetUserId, status])
  @@index([status, createdAt])
}
